{
  "name": "programming-study-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "courses/vue/packages/*",
    "apps/learning-portal"
  ],
  "scripts": {
    "dev": "npm run portal:dev",
    "build": "npm run vue:build && npm run java:compile",
    "portal:dev": "npm run dev --workspace @programming-study/learning-portal",
    "portal:build": "npm run build --workspace @programming-study/learning-portal",
    "vue:dev": "npm run portal:dev",
    "vue:build": "npm run typecheck && npm run portal:build",
    "vue:test": "vitest run --config courses/vue/vitest.config.ts",
    "typecheck": "tsc -p courses/vue/tsconfig.json --noEmit && npm run typecheck --workspace @programming-study/learning-portal",
    "test": "vitest --config courses/vue/vitest.config.ts",
    "test:run": "vitest run --config courses/vue/vitest.config.ts",
    "java:compile": "pwsh -NoProfile -File courses/java/scripts/course.ps1 -Action Compile",
    "java:run": "pwsh -NoProfile -File courses/java/scripts/course.ps1 -Action Run",
    "java:test": "pwsh -NoProfile -File courses/java/scripts/course.ps1 -Action Test",
    "permissions:check": "pwsh -NoProfile -File scripts/workspace-permissions.ps1",
    "permissions:check:all": "pwsh -NoProfile -File scripts/workspace-permissions.ps1 -All",
    "permissions:fix": "pwsh -NoProfile -File scripts/workspace-permissions.ps1 -Fix",
    "permissions:reset": "pwsh -NoProfile -File scripts/workspace-permissions.ps1 -Fix -ResetAcl"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
